---
import Layout from '../layouts/Layout.astro';

// Always prefix internal links with BASE_URL so they work on GitHub Pages.
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');

// ✏️ EDIT ME — all the placeholder content for the page lives here.
const site = {
  // ✏️ EDIT ME — your name / brand
  name: 'Your Name',
  // ✏️ EDIT ME — a short, punchy tagline
  tagline: 'Builder. Tinkerer. Lifelong learner.',
  // ✏️ EDIT ME — one or two sentences about you
  intro:
    'Welcome to my corner of the internet. I build things for the web, write about what I learn, and love working on ambitious projects.',
  // ✏️ EDIT ME — hero buttons (use `${base}...` for internal links)
  primaryCta: { label: 'See my work', href: '#features' },
  secondaryCta: { label: 'Get in touch', href: 'mailto:you@example.com' },
  // ✏️ EDIT ME — three feature cards
  features: [
    {
      icon: '⚡',
      title: 'Fast by default',
      body: 'Static HTML generated by Astro, served globally by GitHub Pages. No JavaScript unless you need it.',
    },
    {
      icon: '🎨',
      title: 'Easy to customize',
      body: 'Change colors in one place via CSS variables, and edit all the copy from a single object.',
    },
    {
      icon: '🚀',
      title: 'Deploys on push',
      body: 'Every push to main builds and publishes the site automatically with GitHub Actions.',
    },
    {
      icon: '☀️',
      title: 'Wellington sunlight maps',
      body: 'Interactive maps of average hours of direct sun across Wellington City, Porirua, Lower Hutt and Upper Hutt, with a garden and roof score for every address, modelled from 1 m LiDAR.',
      href: `${base}sun/`,
      cta: 'Browse the maps →',
    },
  ],
  // ✏️ EDIT ME — footer links
  links: [
    { label: 'GitHub', href: 'https://github.com/bendari500-design' },
    { label: 'Email', href: 'mailto:you@example.com' },
  ],
};

const year = new Date().getFullYear();
---

<Layout title={`${site.name} — ${site.tagline}`} description={site.intro}>
  <header class="nav">
    <a class="brand" href={base}>{site.name}</a>
    <nav>
      <a href={`${base}#features`}>Features</a>
      <a href={`${base}sun/`}>Sunlight maps</a>
      <a href={site.secondaryCta.href}>Contact</a>
    </nav>
  </header>

  <main>
    <section class="hero">
      <p class="eyebrow">Hello, I'm</p>
      <h1>{site.name}</h1>
      <p class="tagline">{site.tagline}</p>
      <p class="intro">{site.intro}</p>
      <div class="actions">
        <a class="btn btn-primary" href={site.primaryCta.href}>{site.primaryCta.label}</a>
        <a class="btn btn-ghost" href={site.secondaryCta.href}>{site.secondaryCta.label}</a>
      </div>
    </section>

    <section id="features" class="features">
      {
        site.features.map((f) =>
          f.href ? (
            <a class="card card-link" href={f.href}>
              <div class="icon" aria-hidden="true">{f.icon}</div>
              <h2>{f.title}</h2>
              <p>{f.body}</p>
              {f.cta && <span class="card-cta">{f.cta}</span>}
            </a>
          ) : (
            <article class="card">
              <div class="icon" aria-hidden="true">{f.icon}</div>
              <h2>{f.title}</h2>
              <p>{f.body}</p>
            </article>
          )
        )
      }
    </section>
  </main>

  <footer class="footer">
    <p>© {year} {site.name}. Built with Astro.</p>
    <ul>
      {site.links.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
    </ul>
  </footer>
</Layout>

<style>
  .nav,
  main,
  .footer {
    max-width: var(--max-width);
    margin: 0 auto;
    padding: 0 1.5rem;
  }

  .nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-top: 1.5rem;
    padding-bottom: 1.5rem;
  }

  .brand {
    font-weight: 700;
    color: var(--text);
    text-decoration: none;
    letter-spacing: -0.01em;
  }

  .nav nav {
    display: flex;
    gap: 1.5rem;
  }

  .nav nav a {
    color: var(--text-muted);
    text-decoration: none;
    font-size: 0.95rem;
  }

  .nav nav a:hover {
    color: var(--text);
  }

  .hero {
    padding: 6rem 0 5rem;
    text-align: center;
    position: relative;
  }

  .hero::before {
    content: '';
    position: absolute;
    inset: 0;
    margin: auto;
    width: min(700px, 90vw);
    height: 400px;
    background: radial-gradient(closest-side, rgba(124, 92, 255, 0.25), transparent);
    z-index: -1;
    filter: blur(20px);
  }

  .eyebrow {
    color: var(--accent-2);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    font-size: 0.8rem;
    margin: 0 0 0.75rem;
  }

  h1 {
    font-size: clamp(2.75rem, 7vw, 4.75rem);
    line-height: 1.05;
    margin: 0;
    letter-spacing: -0.03em;
    background: linear-gradient(135deg, #fff 30%, var(--accent) 70%, var(--accent-2));
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .tagline {
    font-size: clamp(1.15rem, 2.5vw, 1.5rem);
    color: var(--text);
    margin: 1rem 0 0.5rem;
    font-weight: 500;
  }

  .intro {
    max-width: 620px;
    margin: 0 auto;
    color: var(--text-muted);
    font-size: 1.05rem;
  }

  .actions {
    display: flex;
    gap: 1rem;
    justify-content: center;
    flex-wrap: wrap;
    margin-top: 2.25rem;
  }

  .btn {
    display: inline-block;
    padding: 0.8rem 1.5rem;
    border-radius: 999px;
    font-weight: 600;
    text-decoration: none;
    transition: transform 0.15s ease, background 0.15s ease, border-color 0.15s ease;
  }

  .btn:hover {
    transform: translateY(-2px);
  }

  .btn-primary {
    background: linear-gradient(135deg, var(--accent), #5b3df5);
    color: #fff;
    box-shadow: 0 8px 30px rgba(124, 92, 255, 0.35);
  }

  .btn-ghost {
    border: 1px solid var(--border);
    color: var(--text);
    background: var(--bg-elevated);
  }

  .btn-ghost:hover {
    border-color: var(--accent);
  }

  .features {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 1.25rem;
    padding: 2rem 0 6rem;
  }

  .card {
    background: var(--bg-elevated);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 1.75rem;
    transition: border-color 0.2s ease, transform 0.2s ease;
  }

  .card:hover {
    border-color: var(--accent);
    transform: translateY(-3px);
  }

  .icon {
    font-size: 1.75rem;
    margin-bottom: 0.75rem;
  }

  .card h2 {
    font-size: 1.2rem;
    margin: 0 0 0.5rem;
  }

  .card p {
    margin: 0;
    color: var(--text-muted);
  }

  .card-link {
    display: block;
    color: var(--text);
    text-decoration: none;
  }

  .card-cta {
    display: inline-block;
    margin-top: 1rem;
    color: var(--accent-2);
    font-weight: 600;
    font-size: 0.95rem;
  }

  .footer {
    border-top: 1px solid var(--border);
    padding-top: 2rem;
    padding-bottom: 3rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 1rem;
    color: var(--text-muted);
    font-size: 0.9rem;
  }

  .footer p {
    margin: 0;
  }

  .footer ul {
    list-style: none;
    display: flex;
    gap: 1.25rem;
    margin: 0;
    padding: 0;
  }

  .footer a {
    color: var(--text-muted);
    text-decoration: none;
  }

  .footer a:hover {
    color: var(--text);
  }
</style>
